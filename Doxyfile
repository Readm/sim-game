# 项目信息
PROJECT_NAME           = "仿真系统"
PROJECT_NUMBER        = 1.0
PROJECT_BRIEF         = "基于Tick-Tock机制的仿真系统"
OUTPUT_LANGUAGE       = Chinese
OUTPUT_DIRECTORY      = docs

# 输入设置
INPUT                 = src/sim/include README.md
FILE_PATTERNS         = *.h *.cpp *.md
RECURSIVE             = YES
EXTRACT_ALL           = YES
EXTRACT_PRIVATE       = YES
EXTRACT_STATIC        = YES

# 输出设置
GENERATE_HTML         = YES
HTML_OUTPUT          = html
HTML_FILE_EXTENSION  = .html
